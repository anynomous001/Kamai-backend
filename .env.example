# ─────────────────────────────────────────────────────────────
# Kamai Backend — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=kamai-backend
APP_URL=http://localhost:3001

# ── Dev Bypass Authentication (local/test only, never in production) ──
# When true, unauthenticated requests are treated as DEV_BAKER_ID.
# The app already hard-blocks this in production (NODE_ENV=production).
DEV_BYPASS_AUTH=false
DEV_BAKER_ID=
DEV_PHONE=
DEV_SESSION_ID=

# ── Database (PostgreSQL / Supabase) ───────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kamai
DIRECT_URL=

# ── Supabase Storage (optional — required only for upload/storage actions) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=business

# ── Support ─────────────────────────────────────────────────
SUPPORT_WHATSAPP_NUMBER=

# ── JWT (Authentication) ────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookie Signing ──────────────────────────────────────────
COOKIE_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# ── Redis (sessions / rate limiting / caching) ──────────────
REDIS_URL=redis://localhost:6379

# ── Razorpay (payments & billing) ──────────────────────────
# Local/dev/staging: use a TEST-mode key (rzp_test_...) only. The app
# refuses to start outside NODE_ENV=production if this is a live key
# (rzp_live_...) — see src/config/env.ts. Live keys belong only in the
# real production deployment's secret store (or .env.production, already
# gitignored, never used locally).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan used for the first 149 paid subscriptions ever created (Rs149/month).
RAZORPAY_EARLY_ADOPTER_PLAN_ID=plan_early_adopter_1
# Plan used from the 150th paid subscription onward (Rs199/month). See
# paid_subscription_counter sequence / billing.service.ts createSubscription.
RAZORPAY_STANDARD_PLAN_ID=plan_standard_1

# ── Twilio (WhatsApp notifications) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Resend (Email OTP delivery) ─────────────────────────────
RESEND_API_KEY=

# ── Sentry (error monitoring) ───────────────────────────────
SENTRY_DSN=

# ── CORS ────────────────────────────────────────────────────
# Comma-separated exact-match allowlist (wildcard '*' segments supported per entry,
# but avoid broad patterns like '*.vercel.app' — those are attacker-obtainable domains).
# Production must include the real frontend origin, e.g.:
# CORS_ORIGIN=http://localhost:3000,https://app.getkamai.online
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
